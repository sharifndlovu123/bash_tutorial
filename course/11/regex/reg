#!/usr/bin/env bash


# first portion = match anything till / (not escape \), then anything with space - space
# second portion = {means digit count}, [0-9] means range, 
regex='^.*\/(.*) - ([0-9]{4}-[0-9]{2}-[0-9]{2})\..*$'
for f in ./images/*; do
    if ! [[ $f =~ $regex ]]; then
        echo "$f didnt match pattern"
        continue
    fi

    #  the output might be tricky, but here out it returns values
    full_string="${BASH_REMATCH[@]}" # full string everything
    name="${BASH_REMATCH[1]}" # first capture group, the match
    date="${BASH_REMATCH[2]}"

    echo "$date: $name"
done