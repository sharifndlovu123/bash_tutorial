#!/usr/bin/env bash
# cut and sed on /etc/passwd
# Fields: login-name, password placeholder, uid, gid, comment, home dir, shell
# (see: man 5 passwd)

cat /etc/passwd | cut -d : -f 1
cut -d : -f 1 /etc/passwd            # same, without cat

cut -d : -f 2 /etc/passwd
cut -d : -f 1,3 /etc/passwd
cut -d : -f 5 /etc/passwd
cut -d : -f 6 /etc/passwd
cut -d : -f 1,7 /etc/passwd

# sed substitutions: s/search/replace/
# (tr only swaps single characters; use sed to replace words or patterns)
cut -d : -f 1,3 /etc/passwd | grep "$USER" | sed "s/$USER/buddy/"

# '.' matches any single character, so this is a regular expression
cut -d : -f 1,3 /etc/passwd | grep "$USER" | sed 's/s..f/buddy/'

# several expressions can be stacked with -e
cut -d : -f 1,7 /etc/passwd | grep "$USER" | sed -e 's/s..f/buddy/' -e 's/bash/fish/'

# the delimiter does not have to be '/'. Handy when the text contains slashes
echo '/home/dave' | sed 's#/home#/Users#'
