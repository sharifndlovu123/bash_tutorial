#!/usr/bin/env bash

my-func() {
	echo "hello world"
}

# SIGINFO only exists on BSD/macOS (ctrl-t). On Linux use a user signal:
#   kill -USR1 <pid>
echo "pid is $$"
trap my-func SIGUSR1 || exit 1

while true; do
	sleep 1
	echo running
done

