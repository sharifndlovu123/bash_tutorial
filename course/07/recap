#!/bin/bash

declare -A shells

while IFS=: read -r name pass uid gid gecos home shell; do
    echo "found user $name"

    # skip comments, * means it can start with # but end with anything
    if [[ $name == '#'* ]]; then    
        continue
    fi

    shells[$name]=$shell
done < /etc/passwd

echo "$USER shell: ${shells[$USER]}"

# find your own shell easily
getent passwd "$USER" | cut -d : -f 7